# Copy to .env. Never commit .env.
# India first. UAE is the same image with COUNTRY_CODE=AE.

APP_NAME=accumo
ENV=dev
COUNTRY_CODE=IN
BASE_CURRENCY=INR
PUBLIC_HOST=localhost

SECRET_KEY=change-me-to-64-random-bytes
ACCOUNT_HMAC_KEY=change-me-to-another-64-random-bytes
BANK_ENCRYPT_KEY=

DATABASE_URL=postgresql+psycopg://pulse:pulse@localhost:5432/pulse
SESSION_HOURS=12
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300
RETENTION_MONTHS=24
LOG_CUSTOMER_PAYLOADS=false
